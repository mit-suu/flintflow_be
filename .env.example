# Backend environment variables
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/flintflow

# CORS / frontend URL
CLIENT_URL=http://localhost:3000

# JWT secrets
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here

# Token expiration
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# App URL (Frontend URL for email links)
APP_URL=http://localhost:3000

# SMTP / Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=FlintFlow <no-reply@flintflow.io.vn>

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Cloudinary (upload tai lieu / anh diagram)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Default Seed Admin Account
ADMIN_EMAIL=admin@flintflow.io.vn
ADMIN_PASSWORD=Admin@123456

# AI Providers API Keys
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
GEMINI_API_KEY=your_gemini_api_key

# Modal / GLM Configuration
MODAL_BASE_URL=https://trantuanhiep28122003--ep-mary-flintflow-analysis-server.us-west.modal.direct/v1
MODAL_PROXY_TOKEN_ID=your_modal_proxy_token_id
MODAL_PROXY_TOKEN_SECRET=your_modal_proxy_token_secret
MODAL_API_KEY=your_modal_api_key_optional

# PlantUML server (self-host: docker compose up -d plantuml)
PLANTUML_BASE_URL=http://localhost:8080
PLANTUML_TIMEOUT_MS=15000

# Billing mock gateway (Phases §9.2) — webhook ky HMAC-SHA256
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret_min_32_chars
# Reservation credit het han sau bao lau (ms), mac dinh 10 phut
CREDIT_RESERVE_TTL_MS=600000
MOCK_PAYMENT_URL=http://localhost:3000/home/billing/mock-checkout

# Ghi de thu muc assets/ (mac dinh: tu dong tim tu cwd di len)
# FLINTFLOW_ASSETS_DIR=/app/assets
