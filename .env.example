# Backend environment variables — copy sang .env rồi điền giá trị thật.
#
#   cp .env.example .env
#
# `src/config/env.ts` validate file này lúc khởi động và THOÁT nếu sai. Ở production những secret có
# default không an toàn trở thành BẮT BUỘC (≥ 32 ký tự), MONGO_URI và APP_PUBLIC_URL không được trỏ
# localhost. Xem docs/ops.md.

# ─── Cơ bản ────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Chạy trên máy: Mongo standalone là đủ cho phần lớn luồng.
# Chạy compose (docker-compose.yml): replica set rs0 — transaction đa document chỉ có trên replica set.
#   trong compose:  mongodb://mongo:27017/flintflow?replicaSet=rs0
#   từ máy vào compose: mongodb://localhost:27017/flintflow?directConnection=true
MONGO_URI=mongodb://127.0.0.1:27017/flintflow

# CORS + link trong email
CLIENT_URL=http://localhost:3000
APP_URL=http://localhost:3000

# ─── Auth ──────────────────────────────────────────────────────────────
# BẮT BUỘC đặt tường minh, ≥ 32 ký tự ở production. Sinh bằng: openssl rand -base64 48
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=3d
# Cookie refreshToken/accessToken. FE và BE KHÁC site (vd. flintflow.io.vn ↔ *.azurewebsites.net) ⇒ none,
# nếu không trình duyệt không gửi cookie khi gọi /auth/refresh. BE ở subdomain cùng site ⇒ lax + COOKIE_DOMAIN.
COOKIE_SAME_SITE=lax
# vd. .flintflow.io.vn — để trống thì cookie gắn đúng host của BE
COOKIE_DOMAIN=

# Google OAuth — client id (public theo thiết kế), để trống thì tắt đăng nhập Google
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ─── Email ─────────────────────────────────────────────────────────────
# Để trống SMTP_USER/SMTP_PASS ⇒ không gửi mail (dev, test, CI).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=FlintFlow <no-reply@flintflow.io.vn>

# ─── Upload tài liệu / ảnh diagram ─────────────────────────────────────
# Ảnh diagram đã render nằm trong GridFS (bucket `diagram-files`), không phải Cloudinary.
# Cloudinary chỉ dùng cho tài liệu người dùng upload.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Tài khoản admin seed lần đầu ──────────────────────────────────────
ADMIN_EMAIL=admin@flintflow.io.vn
ADMIN_PASSWORD=change_this_before_first_boot

# ─── Provider AI ───────────────────────────────────────────────────────
# Provider của MỖI lượt gọi do frontmatter của skill quyết định
# (assets/skills/<kind>/<id>/SKILL.md → `provider:`), không phải biến môi trường.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Endpoint tương thích OpenAI đang phục vụ GLM (Modal). KHÔNG có giá trị mặc định trong code —
# để trống thì mọi skill `provider: glm` trả AI_PROVIDER_NOT_CONFIGURED.
MODAL_BASE_URL=
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=
MODAL_API_KEY=

# Ghi đè provider cho MỌI lượt gọi, bỏ qua frontmatter. Chỉ dùng cho CI / smoke test.
# `mock` không gọi mạng và trả output hợp schema theo ActionType (op rỗng) — đủ để đi hết một step.
# AI_PROVIDER_OVERRIDE=mock

# S-9.2 Quality Lens bằng LLM — mặc định TẮT (Phases §9.1, chưa có ngân sách).
REVIEW_LLM_ENABLED=false

# ─── PlantUML ──────────────────────────────────────────────────────────
# Self-host: docker compose up -d plantuml. Ở production là service RIÊNG, không phải sidecar.
PLANTUML_BASE_URL=http://localhost:8080
PLANTUML_TIMEOUT_MS=15000

# ─── Billing (payment_service dùng chung, VietQR/SePay) ────────────────
# Để trống ⇒ checkout trả 503 PAYMENT_SERVICE_NOT_CONFIGURED.
PAYMENT_SERVICE_URL=
PAYMENT_CLIENT_ID=
PAYMENT_API_KEY=
PAYMENT_SERVICE_TIMEOUT_MS=10000
# Domain public của BE này: payment service POST về <APP_PUBLIC_URL>/api/v1/billing/payment-callback.
# Test trên máy: dùng ngrok/cloudflared — payment service chạy trên Azure không gọi được localhost.
# Callback KHÔNG tin payload: nó kiểm client_id rồi đọc lại đơn hàng từ payment service,
# nên không có (và không cần) webhook secret.
APP_PUBLIC_URL=http://localhost:5000

# Reservation credit quá hạn bị cron dọn (mặc định 10 phút)
CREDIT_RESERVE_TTL_MS=600000

# ─── Khác ──────────────────────────────────────────────────────────────
# Ghi đè thư mục assets/ (mặc định: tự tìm từ cwd đi lên). Image production đặt sẵn /app/assets.
# FLINTFLOW_ASSETS_DIR=/app/assets

# Chạy test e2e gọi provider THẬT (tốn tiền): E2E_AI=1 npm run test:e2e-ai
# E2E_AI=0
