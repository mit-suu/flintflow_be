  "spine": {
    "project": {
      "name": "GroomBook",
      "vision": "Let a single independent pet groomer run the whole appointment book from one phone, so no booking is double-sold and no pet owner forgets an appointment.",
      "goals": [
        "Cut missed grooming appointments by sending every pet owner an SMS reminder the day before",
        "Let the groomer record a phone booking in under one minute",
        "Show the groomer a daily schedule with each pet's notes and coat history"
      ],
      "type": "mobile_application",
      "domain": "Pet grooming / small-business scheduling",
      "complexity": "low",
      "form_factor": "mobile_app",
      "stakes": "internal",
      "working_mode": "fast",
      "release_scope": {
        "in": [
          "Groomer account with email and password sign-in",
          "Appointment book: create, reschedule and cancel bookings taken by phone",
          "Pet records with owner phone number, breed and grooming notes",
          "SMS reminder to the pet owner the day before an appointment"
        ],
        "out": [
          "Online self-booking by pet owners (pet owners have no account and never sign in)",
          "Staff accounts — the salon has exactly one groomer",
          "Card payments"
        ]
      }
    },
