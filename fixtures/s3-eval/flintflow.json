  "spine": {
    "project": {
      "name": "FlintFlow",
      "vision": "Enable a solo founder or business analyst to turn a raw product idea into a complete, internally consistent SRS document through a guided AI conversation, without hiring a requirements engineer.",
      "goals": [
        "Produce a baseline-quality SRS following the FPT template within one working day",
        "Keep every generated statement traceable to a structured field in the SRS Spine",
        "Block no export: a watermarked working draft is always available after assembly",
        "Keep AI spend predictable through per-step credit reservation and metering"
      ],
      "type": "web_application",
      "domain": "Requirements engineering / AI-assisted documentation",
      "complexity": "high",
      "form_factor": "responsive_web",
      "stakes": "production",
      "working_mode": "fast",
      "release_scope": {
        "in": [
          "Guided Brief-to-SRS pipeline (B-0 through S-9) with per-step gates",
          "SRS Spine with op-based writes, invariants and deterministic checks",
          "Five server-rendered PlantUML diagram kinds",
          "Word export with DRAFT watermark and baseline clean export",
          "In-app notifications, credit ledger with mock payment gateway",
          "Read-only admin views for users, metrics and AI cost"
        ],
        "out": [
          "Import of existing SRS documents (.docx) and change requests on them",
          "PDF export and handoff summary",
          "Project sharing, cloning and role-based collaboration",
          "Email notification channel",
          "Admin write operations (user editing, prompt override)"
        ]
      }
    },
