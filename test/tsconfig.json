{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // Test dùng `Array.prototype.at` (ES2022); target ES2020 của tsconfig gốc không khai `lib` nên
    // `tsc` báo TS2550. Runtime là Node 22, chỉ cần mở lib cho lượt typecheck của test.
    "lib": ["ES2023"],
    "rootDir": "..",
    "noEmit": true
  },
  "include": ["../src", "./**/*.ts", "../vitest.config.ts"],
  "exclude": ["../src/_archive"]
}
