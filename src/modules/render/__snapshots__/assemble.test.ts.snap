          ],
          "rows": [
            [
              [
                {
                  "text": "Passwords are stored as salted bcrypt hashes; tokens and secrets never appear in logs or admin views.",
                },
              ],
              [
                {
                  "text": "",
                },
              ],
              [
                {
                  "text": "",
