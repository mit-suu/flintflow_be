        },
        {
          "level": 4,
          "text": "Validations",
          "type": "heading",
        },
        {
          "items": [
            [
              {
                "text": "[business] At most 8 elicitation turns and 3 regenerates are allowed per phase.",
              },
            ],
          ],
          "type": "bullet_list",
        },
      ],
      "heading": "Request Revision at Gate",
