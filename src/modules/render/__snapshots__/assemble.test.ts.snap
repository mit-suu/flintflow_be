      "number": "3.5",
      "status": "accepted",
    },
    {
      "awaiting_reaccept": false,
      "blocks": [
        {
          "runs": [
            {
              "bold": true,
              "text": "Trigger: ",
            },
            {
              "text": "User opens the Verification panel.",
            },
          ],
          "type": "paragraph",
        },
        {
          "runs": [
            {
              "bold": true,
              "text": "Description: ",
            },
            {
              "text": "Shows open red and yellow flags with rule, target and remediation step.",
            },
          ],
          "type": "paragraph",
        },
        {
          "level": 4,
          "text": "Normal Flow",
          "type": "heading",
        },
        {
          "items": [
            [
              {
                "text": "System runs the deterministic check on the current spine_version.",
              },
            ],
            [
              {
                "text": "System lists open flags grouped by level.",
              },
            ],
            [
              {
                "text": "Each flag links to its remediation step.",
              },
            ],
          ],
          "type": "numbered_list",
        },
        {
          "level": 4,
          "text": "Validations",
          "type": "heading",
        },
        {
          "items": [
            [
              {
                "text": "[business] Every red flag must carry an executable remediation step.",
              },
            ],
          ],
          "type": "bullet_list",
        },
      ],
      "heading": "List Open Flags",
      "id": "function:FN038",
      "level": 3,
      "number": "3.5.1",
      "status": "accepted",
    },
    {
      "awaiting_reaccept": false,
      "blocks": [
        {
          "runs": [
            {
              "bold": true,
              "text": "Trigger: ",
            },
            {
              "text": "User clicks Waive on a waivable red flag.",
            },
          ],
          "type": "paragraph",
        },
        {
          "runs": [
            {
              "bold": true,
              "text": "Description: ",
            },
            {
              "text": "Waives an eligible red flag with a mandatory typed reason.",
            },
          ],
          "type": "paragraph",
        },
        {
          "level": 4,
          "text": "Normal Flow",
          "type": "heading",
        },
        {
          "items": [
            [
              {
                "text": "User types the waive reason.",
              },
            ],
            [
              {
                "text": "System records the waiver with the current spine_version.",
              },
            ],
            [
              {
                "text": "System recounts the open red flags.",
              },
            ],
          ],
          "type": "numbered_list",
        },
        {
          "level": 4,
          "text": "Abnormal Flow",
          "type": "heading",
        },
        {
          "items": [
            [
              {
                "text": "The rule is dead_reference, array_empty or render_error: system refuses the waive.",
              },
            ],
          ],
          "type": "numbered_list",
        },
        {
          "level": 4,
          "text": "Validations",
          "type": "heading",
        },
        {
          "items": [
            [
              {
                "text": "[required] Waive reason must be typed by the user and be at least 20 characters.",
              },
            ],
            [
              {
                "text": "[business] Waivers expire when spine_version changes and the condition still holds.",
              },
            ],
          ],
          "type": "bullet_list",
        },
        {
          "level": 4,
          "text": "Business Rules",
          "type": "heading",
        },
        {
          "items": [
            [
              {
                "text": "A red-flag waiver requires a user-typed reason of at least 20 characters and expires when spine_version changes.",
              },
            ],
          ],
          "type": "bullet_list",
        },
      ],
      "heading": "Waive Flag",
      "id": "function:FN039",
      "level": 3,
      "number": "3.5.2",
      "status": "accepted",
    },
    {
      "awaiting_reaccept": false,
      "blocks": [
        {
          "runs": [
            {
              "bold": true,
              "text": "Trigger: ",
            },
            {
              "text": "User describes a change in the panel.",
            },
          ],
          "type": "paragraph",
        },
        {
          "runs": [
            {
              "bold": true,
              "text": "Description: ",
            },
            {
              "text": "Turns a natural-language change request into a previewable op batch.",
            },
          ],
          "type": "paragraph",
        },
        {
          "level": 4,
          "text": "Normal Flow",
          "type": "heading",
        },
        {
          "items": [
            [
              {
                "text": "User describes the change.",
              },
            ],
            [
              {
                "text": "System runs the impact query over the reference fields.",
              },
            ],
            [
              {
                "text": "System proposes an op batch with the impact scope.",
              },
            ],
          ],
          "type": "numbered_list",
        },
        {
          "level": 4,
          "text": "Abnormal Flow",
          "type": "heading",
        },
        {
          "items": [
            [
              {
                "text": "The request is ambiguous: system asks a clarifying question before proposing ops.",
              },
            ],
          ],
          "type": "numbered_list",
        },
        {
          "level": 4,
          "text": "Validations",
          "type": "heading",
        },
        {
          "items": [
            [
              {
                "text": "[business] A change touching referenced fields must present impact scope before apply.",
              },
            ],
          ],
          "type": "bullet_list",
        },
      ],
      "heading": "Submit Change Request",
      "id": "function:FN040",
      "level": 3,
      "number": "3.5.3",
      "status": "accepted",
    },
    {
      "awaiting_reaccept": false,
      "blocks": [
        {
          "runs": [
            {
              "bold": true,
              "text": "Trigger: ",
            },
            {
              "text": "System proposes an op batch.",
            },
          ],
          "type": "paragraph",
        },
        {
          "runs": [
            {
              "bold": true,
              "text": "Description: ",
            },
            {
              "text": "Shows a field-level before/after diff and the dependent sections that become stale.",
            },
          ],
          "type": "paragraph",
        },
        {
          "level": 4,
          "text": "Normal Flow",
          "type": "heading",
        },
        {
          "items": [
            [
              {
                "text": "System renders the diff per op.",
              },
            ],
            [
              {
                "text": "System lists dependent sections across owner, reader and derived columns.",
              },
            ],
            [
              {
                "text": "User confirms or rejects the batch.",
              },
            ],
          ],
          "type": "numbered_list",
        },
        {
          "level": 4,
          "text": "Abnormal Flow",
          "type": "heading",
        },
        {
          "items": [
            [
              {
                "text": "User rejects: the section stays stale, which is a valid outcome.",
              },
            ],
          ],
          "type": "numbered_list",
        },
      ],
      "heading": "Preview Impact Diff",
      "id": "function:FN041",
      "level": 3,
      "number": "3.5.4",
      "status": "accepted",
    },
    {
      "awaiting_reaccept": false,
      "blocks": [
        {
          "runs": [
            {
              "bold": true,
              "text": "Trigger: ",
            },
            {
              "text": "User confirms the previewed batch.",
            },
          ],
          "type": "paragraph",
        },
        {
          "runs": [
            {
              "bold": true,
              "text": "Description: ",
            },
            {
              "text": "Applies the whole op batch atomically and records the change history.",
            },
          ],
          "type": "paragraph",
        },
        {
          "level": 4,
          "text": "Normal Flow",
          "type": "heading",
        },
        {
          "items": [
            [
              {
                "text": "System applies all ops in one transaction.",
              },
            ],
            [
              {
                "text": "System checks invariants at the end of the batch.",
              },
            ],
            [
              {
                "text": "System records changes[] rows and bumps spine_version once.",
              },
            ],
          ],
          "type": "numbered_list",
        },
        {
          "level": 4,
          "text": "Abnormal Flow",
          "type": "heading",
        },
        {
          "items": [
            [
              {
                "text": "An invariant fails: system rejects the whole batch and lists the referencing elements.",
              },
            ],
          ],
          "type": "numbered_list",
        },
        {
          "level": 4,
          "text": "Validations",
          "type": "heading",
        },
        {
          "items": [
            [
              {
                "text": "[business] Invariants are checked at the end of the batch, not per op.",
              },
            ],
          ],
          "type": "bullet_list",
        },
        {
          "level": 4,
          "text": "Business Rules",
          "type": "heading",
        },
        {
          "items": [
            [
              {
                "text": "An applied change transaction bumps spine_version exactly once and checks invariants at the end of the batch.",
              },
            ],
          ],
          "type": "bullet_list",
        },
      ],
      "heading": "Apply Change Transaction",
      "id": "function:FN042",
      "level": 3,
      "number": "3.5.5",
      "status": "accepted",
    },
    {
