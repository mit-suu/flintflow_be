    {
      "awaiting_reaccept": false,
      "blocks": [
        {
          "header": [
            [
              {
                "text": "Feature",
              },
            ],
            [
              {
                "text": "Screen",
              },
            ],
            [
              {
                "text": "Description",
              },
            ],
          ],
          "rows": [
            [
              [
                {
                  "text": "3.2 Authentication & Onboarding",
                },
              ],
              [
                {
                  "text": "Login",
                },
              ],
              [
                {
                  "text": "Entry screen where a user authenticates with email/password or Google.",
                },
              ],
            ],
            [
              [
                {
                  "text": "3.2 Authentication & Onboarding",
                },
              ],
              [
                {
                  "text": "Register",
                },
              ],
              [
                {
                  "text": "Account creation with email verification.",
                },
              ],
            ],
            [
              [
                {
                  "text": "3.2 Authentication & Onboarding",
                },
              ],
              [
                {
                  "text": "Forgot Password",
                },
              ],
              [
                {
                  "text": "Popup to request a password reset link.",
                },
              ],
            ],
            [
              [
                {
                  "text": "3.2 Authentication & Onboarding",
                },
              ],
              [
                {
                  "text": "Onboarding",
                },
              ],
              [
                {
                  "text": "First-run guided tour introducing the Brief-to-SRS pipeline.",
                },
              ],
            ],
            [
              [
                {
                  "text": "3.3 Project Dashboard",
                },
              ],
              [
                {
                  "text": "Project Dashboard",
                },
              ],
              [
                {
                  "text": "Lists the user's projects with status, readiness and quick actions.",
                },
              ],
            ],
            [
              [
                {
                  "text": "3.3 Project Dashboard",
                },
              ],
              [
                {
                  "text": "Create Project",
                },
              ],
              [
                {
                  "text": "Popup to create a new project and choose the working mode.",
                },
              ],
            ],
            [
              [
                {
                  "text": "3.4 SRS Workspace",
                },
              ],
              [
                {
                  "text": "Project Workspace",
                },
              ],
              [
                {
                  "text": "Main working screen: chat pane drives the pipeline while the document pane renders the SRS read-only.",
                },
              ],
            ],
            [
              [
                {
                  "text": "3.4 SRS Workspace",
                },
              ],
              [
                {
                  "text": "Diagram Preview",
                },
              ],
              [
                {
                  "text": "Full-size preview of a rendered PlantUML diagram.",
                },
              ],
            ],
            [
              [
                {
                  "text": "3.5 Verification & Export",
                },
              ],
              [
                {
                  "text": "Verification & Change Panel",
                },
              ],
              [
                {
                  "text": "Shows open flags, readiness score and lets the user request and apply changes with impact preview.",
                },
              ],
            ],
            [
              [
                {
                  "text": "3.5 Verification & Export",
                },
              ],
              [
                {
                  "text": "Export",
                },
              ],
              [
                {
                  "text": "Configure and download the Word export: watermarked working draft or clean baseline.",
                },
              ],
            ],
            [
              [
                {
                  "text": "3.6 Billing & Notifications",
                },
              ],
              [
                {
                  "text": "Plan & Pricing",
                },
              ],
              [
                {
                  "text": "Displays subscription plans and starts a credit purchase.",
                },
              ],
            ],
            [
              [
                {
                  "text": "3.6 Billing & Notifications",
                },
              ],
              [
                {
                  "text": "Billing History",
                },
              ],
              [
                {
                  "text": "Chronological list of credit transactions and balance.",
                },
              ],
            ],
            [
              [
                {
                  "text": "3.6 Billing & Notifications",
                },
              ],
              [
                {
                  "text": "Notification Center",
                },
              ],
              [
                {
                  "text": "In-app notification inbox with read state management.",
                },
              ],
            ],
            [
              [
                {
                  "text": "3.7 Administration",
                },
              ],
              [
                {
                  "text": "Admin User List",
                },
              ],
              [
                {
                  "text": "Read-only paginated list of all user accounts.",
                },
              ],
            ],
            [
              [
                {
                  "text": "3.7 Administration",
                },
              ],
              [
                {
                  "text": "Admin User Detail",
                },
              ],
              [
                {
                  "text": "Read-only profile of one user with projects and credit balance.",
                },
              ],
            ],
            [
              [
                {
                  "text": "3.7 Administration",
                },
              ],
              [
                {
                  "text": "Admin Metrics Dashboard",
                },
              ],
              [
                {
                  "text": "Read-only platform usage metrics over a selectable time range.",
                },
              ],
            ],
            [
              [
                {
                  "text": "3.7 Administration",
                },
              ],
              [
                {
                  "text": "Admin AI Cost Report",
                },
              ],
              [
                {
                  "text": "Read-only AI spend grouped by provider and by project.",
                },
              ],
            ],
            [
              [
                {
                  "text": "3.7 Administration",
                },
              ],
              [
                {
                  "text": "Admin Prompt Templates",
                },
              ],
              [
                {
                  "text": "Read-only browser of the on-disk skill assets and their versions.",
                },
              ],
            ],
            [
              [
                {
                  "text": "3.7 Administration",
                },
              ],
              [
                {
                  "text": "Admin Audit Log",
                },
              ],
              [
                {
                  "text": "Read-only list of security-relevant events.",
                },
              ],
            ],
