          "type": "bullet_list",
        },
        {
          "level": 2,
          "text": "High-Level Business Rules",
          "type": "heading",
        },
        {
          "items": [
            [
              {
                "text": "Every statement rendered into the SRS must be traceable to a structured Spine field written by an accepted step.",
              },
            ],
            [
              {
                "text": "Credits are reserved before any model call and settled or refunded when the call ends.",
              },
            ],
            [
              {
                "text": "A baseline may only be signed when zero unresolved, unwaived red flags remain.",
              },
            ],
            [
              {
                "text": "All content rendered into the SRS document is written in English.",
              },
            ],
          ],
          "type": "bullet_list",
        },
