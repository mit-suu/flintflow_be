    {
      "blocks": [],
      "heading": "Requirement Appendix",
      "id": "group:5",
      "level": 1,
      "number": "5",
    },
    {
      "awaiting_reaccept": false,
      "blocks": [
        {
          "items": [
            [
              {
                "text": "Raw model output that fails schema parsing is never persisted into the Spine.",
              },
            ],
            [
              {
                "text": "An applied change transaction bumps spine_version exactly once and checks invariants at the end of the batch.",
              },
            ],
            [
              {
                "text": "A red-flag waiver requires a user-typed reason of at least 20 characters and expires when spine_version changes.",
              },
            ],
            [
              {
                "text": "Credits are granted only on a verified payment-gateway webhook processed at most once per event id.",
              },
            ],
            [
              {
                "text": "Baseline exports render from the baseline snapshot, never from the live Spine.",
              },
            ],
          ],
          "type": "bullet_list",
        },
      ],
      "heading": "Business Rules",
      "id": "fixed:5.1",
      "level": 2,
      "number": "5.1",
      "status": "accepted",
    },
    {
      "awaiting_reaccept": false,
      "blocks": [
        {
          "header": [
            [
              {
                "text": "Category",
              },
            ],
            [
              {
                "text": "Statement",
              },
            ],
          ],
          "rows": [
            [
              [
                {
                  "text": "pagination",
                },
              ],
              [
                {
                  "text": "All list screens paginate server-side with a default page size of 20.",
                },
              ],
            ],
            [
              [
                {
                  "text": "date_format",
                },
              ],
              [
                {
                  "text": "All dates are displayed in the user's locale and stored in UTC ISO 8601.",
                },
              ],
            ],
            [
              [
                {
                  "text": "error_handling",
                },
              ],
              [
                {
                  "text": "Every failed action shows a human-readable message with a stable error code.",
                },
              ],
            ],
            [
              [
                {
                  "text": "audit",
                },
              ],
              [
                {
                  "text": "Authentication events, exports and baseline signings are written to the audit log.",
                },
              ],
            ],
            [
              [
                {
                  "text": "session",
                },
              ],
              [
                {
                  "text": "Access tokens expire after 24 hours; expired sessions redirect to Login preserving the return path.",
                },
              ],
            ],
          ],
          "type": "table",
        },
      ],
      "heading": "Common Requirements",
      "id": "fixed:5.2",
      "level": 2,
      "number": "5.2",
      "status": "accepted",
    },
    {
      "awaiting_reaccept": false,
      "blocks": [
        {
          "header": [
            [
              {
                "text": "Code",
              },
            ],
            [
              {
                "text": "Text",
              },
            ],
            [
              {
                "text": "Functions",
              },
            ],
          ],
          "rows": [
            [
              [
                {
                  "text": "E-AUTH-001",
                },
              ],
              [
                {
                  "text": "Invalid email or password.",
                },
              ],
              [
                {
                  "text": "Submit Credentials",
                },
              ],
            ],
            [
              [
                {
                  "text": "E-AUTH-002",
                },
              ],
              [
                {
                  "text": "This email address is already registered.",
                },
              ],
              [
                {
                  "text": "Submit Registration",
                },
              ],
            ],
            [
              [
                {
                  "text": "E-AUTH-003",
                },
              ],
              [
                {
                  "text": "The verification link is invalid or has expired.",
                },
              ],
              [
                {
                  "text": "Verify Email Token, Complete Password Reset",
                },
              ],
            ],
            [
              [
                {
                  "text": "E-CRED-001",
                },
              ],
              [
                {
                  "text": "You do not have enough credits for this action.",
                },
              ],
              [
                {
                  "text": "Send Chat Message",
                },
              ],
            ],
            [
              [
                {
                  "text": "E-PIPE-001",
                },
              ],
              [
                {
                  "text": "The model response could not be parsed. No content was saved.",
                },
              ],
              [
                {
                  "text": "Stream AI Response",
                },
              ],
            ],
            [
              [
                {
                  "text": "E-SPINE-001",
                },
              ],
              [
                {
                  "text": "This change was rejected because it would break document consistency.",
                },
              ],
              [
                {
                  "text": "Accept Step at Gate, Apply Change Transaction",
                },
              ],
            ],
            [
              [
                {
                  "text": "E-EXPORT-001",
                },
              ],
              [
                {
                  "text": "The document has not been assembled yet. Run Document Assembly first.",
                },
              ],
              [
                {
                  "text": "Configure Export Options, Show Export Blockers",
                },
              ],
            ],
            [
              [
                {
                  "text": "E-PAY-001",
                },
              ],
              [
                {
                  "text": "The payment could not be completed. You have not been charged.",
                },
              ],
              [
                {
                  "text": "Initiate Checkout",
                },
              ],
            ],
          ],
          "type": "table",
        },
      ],
      "heading": "Application Messages List",
      "id": "fixed:5.3",
      "level": 2,
      "number": "5.3",
      "status": "accepted",
    },
    {
      "awaiting_reaccept": false,
      "blocks": [
        {
          "header": [
            [
              {
                "text": "Kind",
              },
            ],
            [
              {
                "text": "Statement",
              },
            ],
          ],
          "rows": [
            [
              [
                {
                  "text": "risk",
                },
              ],
              [
                {
                  "text": "Model providers may change pricing or deprecate models mid-project, invalidating the cost model.",
                },
              ],
            ],
            [
              [
                {
                  "text": "assumption",
                },
              ],
              [
                {
                  "text": "Users accept that generated content requires human review before contractual use.",
                },
              ],
            ],
            [
              [
                {
                  "text": "open_question",
                },
              ],
              [
                {
                  "text": "Retention period for addendum content and uploaded source documents is not yet decided.",
                },
              ],
            ],
            [
              [
                {
                  "text": "technical_risk",
                },
              ],
              [
                {
                  "text": "Token cost grows super-linearly with screen count if step context is not projected; mitigation is the context projection rule.",
                },
              ],
            ],
            [
              [
                {
                  "text": "technical_risk",
                },
              ],
              [
                {
                  "text": "MongoDB transactions require a replica set; single-node deployments must run with a one-member replica set.",
                },
              ],
            ],
          ],
          "type": "table",
        },
      ],
      "heading": "Other Requirements",
      "id": "fixed:5.4",
      "level": 2,
      "number": "5.4",
      "status": "accepted",
    },
    {
      "awaiting_reaccept": false,
      "blocks": [
        {
          "header": [
            [
              {
                "text": "Term",
              },
            ],
            [
              {
                "text": "Native",
              },
            ],
            [
              {
                "text": "Definition",
              },
            ],
          ],
          "rows": [
            [
              [
                {
                  "text": "SRS",
                },
              ],
              [
                {
                  "text": "",
                },
              ],
              [
                {
                  "text": "Software Requirements Specification — the output document assembled from the Spine.",
                },
              ],
            ],
            [
              [
                {
                  "text": "Spine",
                },
              ],
              [
                {
                  "text": "Xương sống SRS",
                },
              ],
              [
                {
                  "text": "The structured store of requirement fields that every SRS section renders from.",
                },
              ],
            ],
            [
              [
                {
                  "text": "Op",
                },
              ],
              [
                {
                  "text": "",
                },
              ],
              [
                {
                  "text": "A single atomic write (add, set, remove) addressed by a key-based path into the Spine.",
                },
              ],
            ],
            [
              [
                {
                  "text": "Transaction",
                },
              ],
              [
                {
                  "text": "",
                },
              ],
              [
                {
                  "text": "A batch of ops applied atomically; invariants are checked at the end of the batch.",
                },
              ],
            ],
            [
              [
                {
                  "text": "Baseline",
                },
              ],
              [
                {
                  "text": "",
                },
              ],
              [
                {
                  "text": "A signed, versioned snapshot of the Spine that clean exports render from.",
                },
              ],
            ],
            [
              [
                {
                  "text": "Deterministic Check",
                },
              ],
              [
                {
                  "text": "",
                },
              ],
              [
                {
                  "text": "A model-free rule set that produces red and yellow flags from the Spine graph.",
                },
              ],
            ],
            [
              [
                {
                  "text": "Red Flag",
                },
              ],
              [
                {
                  "text": "Cờ đỏ",
                },
              ],
              [
                {
                  "text": "A blocking finding that prevents baseline signing until resolved or waived.",
                },
              ],
            ],
            [
              [
                {
                  "text": "Yellow Flag",
                },
              ],
              [
                {
                  "text": "Cờ vàng",
                },
              ],
              [
                {
                  "text": "A non-blocking finding surfaced for awareness.",
                },
              ],
            ],
            [
              [
                {
                  "text": "Waiver",
                },
              ],
              [
                {
                  "text": "",
                },
              ],
              [
                {
                  "text": "A user-authorized exception to a red flag, with a typed reason, that expires on version change.",
                },
              ],
            ],
            [
              [
                {
                  "text": "Gate",
                },
              ],
              [
                {
                  "text": "",
                },
              ],
              [
                {
                  "text": "The checkpoint where the user accepts, revises or regenerates a step's output.",
                },
              ],
            ],
            [
              [
                {
                  "text": "Working Draft",
                },
              ],
              [
                {
                  "text": "",
                },
              ],
              [
                {
                  "text": "The always-available watermarked export of the current document state.",
                },
              ],
            ],
            [
              [
                {
                  "text": "Brief",
                },
              ],
              [
                {
                  "text": "",
                },
              ],
              [
                {
                  "text": "The product brief produced in phases B-0 to B-2 that seeds SRS generation.",
                },
              ],
            ],
            [
              [
                {
                  "text": "Addendum",
                },
              ],
              [
                {
                  "text": "",
                },
              ],
              [
                {
                  "text": "Captured side-notes with a target section, triaged into the document later.",
                },
              ],
            ],
            [
              [
                {
                  "text": "Credit",
                },
              ],
              [
                {
                  "text": "",
                },
              ],
              [
                {
                  "text": "The prepaid unit that meters model usage; reserved before calls and settled after.",
                },
              ],
            ],
            [
              [
                {
                  "text": "Stale",
                },
              ],
              [
                {
                  "text": "",
                },
              ],
              [
                {
                  "text": "A section whose source fields changed after its owning step was accepted.",
                },
              ],
            ],
            [
              [
                {
                  "text": "PlantUML",
                },
              ],
              [
