      "number": "3.4.1",
      "status": "accepted",
    },
    {
      "awaiting_reaccept": false,
      "blocks": [
        {
          "runs": [
            {
              "bold": true,
              "text": "Trigger: ",
            },
            {
              "text": "The orchestrator starts a model call.",
            },
          ],
          "type": "paragraph",
        },
        {
          "runs": [
            {
              "bold": true,
              "text": "Description: ",
            },
            {
              "text": "Streams the model response into the chat pane over SSE with a cancel control.",
            },
          ],
          "type": "paragraph",
        },
        {
          "level": 4,
          "text": "Normal Flow",
          "type": "heading",
        },
        {
          "items": [
            [
              {
                "text": "System reserves credits for the call.",
              },
            ],
            [
              {
                "text": "System streams tokens into the chat bubble.",
              },
            ],
            [
              {
                "text": "System settles the reservation when the stream completes.",
              },
            ],
          ],
          "type": "numbered_list",
        },
        {
          "level": 4,
          "text": "Abnormal Flow",
          "type": "heading",
        },
        {
          "items": [
            [
              {
                "text": "Stream is interrupted: system refunds the unused reservation and offers a retry.",
              },
            ],
            [
              {
                "text": "Model output fails schema parse twice: system discards the raw text and shows a structured-parse error.",
              },
            ],
          ],
          "type": "numbered_list",
        },
        {
          "level": 4,
          "text": "Validations",
          "type": "heading",
        },
        {
          "items": [
            [
              {
                "text": "[business] Raw model text must never be written into the Spine when parsing fails.",
              },
            ],
          ],
          "type": "bullet_list",
        },
        {
          "level": 4,
          "text": "Business Rules",
          "type": "heading",
        },
        {
          "items": [
            [
              {
                "text": "Raw model output that fails schema parsing is never persisted into the Spine.",
              },
            ],
          ],
          "type": "bullet_list",
        },
      ],
      "heading": "Stream AI Response",
