    },
    {
      "awaiting_reaccept": false,
      "blocks": [
        {
          "runs": [
            {
              "bold": true,
              "text": "Trigger: ",
            },
            {
              "text": "User clicks Accept on a gate card.",
            },
          ],
          "type": "paragraph",
        },
        {
          "runs": [
            {
              "bold": true,
              "text": "Description: ",
            },
            {
              "text": "Accepts the current step's output, commits its transaction and advances the pipeline.",
            },
          ],
          "type": "paragraph",
        },
        {
          "level": 4,
          "text": "Normal Flow",
          "type": "heading",
        },
        {
          "items": [
            [
              {
                "text": "User clicks Accept.",
              },
            ],
            [
              {
                "text": "System applies the step's op transaction to the Spine.",
              },
            ],
            [
              {
                "text": "System marks the step accepted and advances to the next step.",
              },
            ],
          ],
          "type": "numbered_list",
        },
        {
          "level": 4,
          "text": "Abnormal Flow",
          "type": "heading",
        },
        {
          "items": [
            [
              {
                "text": "The transaction violates an invariant: system rejects the whole batch and shows the referencing elements.",
              },
            ],
          ],
          "type": "numbered_list",
        },
        {
          "level": 4,
          "text": "Validations",
          "type": "heading",
        },
        {
          "items": [
            [
              {
                "text": "[business] spine_version must increase exactly once per accepted transaction.",
              },
            ],
          ],
          "type": "bullet_list",
        },
        {
          "level": 4,
          "text": "Business Rules",
          "type": "heading",
        },
        {
          "items": [
            [
              {
                "text": "An applied change transaction bumps spine_version exactly once and checks invariants at the end of the batch.",
              },
            ],
          ],
          "type": "bullet_list",
        },
      ],
      "heading": "Accept Step at Gate",
      "id": "function:FN032",
      "level": 3,
      "number": "3.4.5",
      "status": "accepted",
    },
    {
