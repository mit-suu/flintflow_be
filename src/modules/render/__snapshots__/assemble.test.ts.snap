    {
      "awaiting_reaccept": false,
      "blocks": [
        {
          "header": [
            [
              {
                "text": "Name",
              },
            ],
            [
              {
                "text": "Trigger",
              },
            ],
            [
              {
                "text": "Description",
              },
            ],
          ],
          "rows": [
            [
              [
                {
                  "text": "Reset Monthly Quota",
                },
              ],
              [
                {
                  "text": "Scheduler fires at 00:00 UTC on the first day of each month.",
                },
              ],
              [
                {
                  "text": "Resets the monthly free-tier credit quota for every active account.",
                },
              ],
            ],
            [
              [
                {
                  "text": "Check Subscription Expiry",
                },
              ],
              [
                {
                  "text": "Scheduler fires daily at 01:00 UTC.",
                },
              ],
              [
                {
                  "text": "Downgrades accounts whose subscription lapsed and notifies them in-app.",
                },
              ],
            ],
            [
              [
                {
                  "text": "Handle Payment Webhook",
                },
              ],
              [
                {
                  "text": "The payment gateway posts a webhook event.",
                },
              ],
              [
                {
                  "text": "Verifies the webhook signature and credits the ledger on successful payment.",
                },
              ],
            ],
            [
              [
                {
                  "text": "Evaluate Completeness Proactively",
                },
              ],
              [
                {
                  "text": "Scheduler fires hourly for projects active in the last day.",
                },
              ],
              [
                {
                  "text": "Runs the deterministic check in the background and refreshes the readiness feedback.",
                },
              ],
            ],
            [
              [
                {
                  "text": "Aggregate AI Costs",
                },
              ],
              [
                {
                  "text": "Scheduler fires daily at 02:00 UTC.",
                },
              ],
              [
                {
                  "text": "Rolls up usage rows into daily cost aggregates for the admin report.",
                },
              ],
            ],
            [
              [
                {
                  "text": "Monitor Service Health",
                },
              ],
              [
                {
                  "text": "Scheduler fires every 5 minutes.",
                },
              ],
              [
                {
                  "text": "Probes the database, the PlantUML server and the LLM provider and records the results.",
                },
              ],
            ],
          ],
          "type": "table",
        },
      ],
      "heading": "Non-Screen Functions",
      "id": "fixed:3.1.4",
      "level": 3,
      "number": "3.1.4",
      "status": "accepted",
    },
    {
      "awaiting_reaccept": false,
      "blocks": [
        {
          "caption": "Entity Relationship Diagram",
          "png": 96,
          "type": "image",
        },
        {
          "header": [
            [
              {
                "text": "Entity",
              },
            ],
            [
              {
                "text": "Description",
              },
            ],
            [
              {
                "text": "Relations",
              },
            ],
          ],
          "rows": [
            [
              [
                {
                  "text": "User",
                },
              ],
              [
                {
                  "text": "An account that owns projects, credits and notifications.",
                },
              ],
              [
                {
                  "text": "Project, CreditLedger, Notification",
                },
              ],
            ],
            [
              [
                {
                  "text": "Project",
                },
              ],
              [
                {
                  "text": "A container for one SRS effort with exactly one Spine.",
                },
              ],
              [
                {
                  "text": "Spine, ChatSession",
                },
              ],
            ],
            [
              [
                {
                  "text": "Spine",
                },
              ],
              [
                {
                  "text": "The structured requirement store all sections render from.",
                },
              ],
              [
                {
                  "text": "Baseline, ChangeRecord, Flag, Diagram",
                },
              ],
            ],
            [
              [
                {
                  "text": "ChatSession",
                },
              ],
              [
                {
                  "text": "A conversation thread; exactly one per project is the pipeline session.",
                },
              ],
              [
                {
                  "text": "",
                },
              ],
            ],
            [
              [
                {
                  "text": "CreditLedger",
                },
              ],
              [
                {
                  "text": "Append-only credit transactions with running balance.",
                },
              ],
              [
                {
                  "text": "UsageRecord",
                },
              ],
            ],
            [
              [
                {
                  "text": "Subscription",
                },
              ],
              [
                {
                  "text": "The plan attached to an account with its renewal window.",
                },
              ],
              [
                {
                  "text": "User",
                },
              ],
            ],
            [
              [
                {
                  "text": "Notification",
                },
              ],
              [
                {
                  "text": "An in-app message with read state.",
                },
              ],
              [
                {
                  "text": "",
                },
              ],
            ],
            [
              [
                {
                  "text": "Baseline",
                },
              ],
              [
                {
                  "text": "A signed snapshot of the Spine with version and waiver count.",
                },
              ],
              [
                {
                  "text": "",
                },
              ],
            ],
            [
              [
                {
                  "text": "ChangeRecord",
                },
              ],
              [
                {
                  "text": "One applied op with before-value, transaction id and sequence.",
                },
              ],
              [
                {
                  "text": "",
                },
              ],
            ],
            [
              [
                {
                  "text": "UsageRecord",
                },
              ],
              [
                {
                  "text": "One model call with tokens, cost and reservation state.",
                },
              ],
              [
                {
                  "text": "",
                },
              ],
            ],
            [
              [
                {
                  "text": "Flag",
                },
              ],
              [
                {
                  "text": "A deterministic-check finding with level, rule and waiver state.",
                },
              ],
              [
                {
                  "text": "",
                },
              ],
            ],
            [
              [
                {
                  "text": "Diagram",
                },
              ],
              [
                {
                  "text": "A rendered PlantUML artifact with source hash and status.",
                },
              ],
              [
                {
                  "text": "",
                },
              ],
            ],
          ],
          "type": "table",
        },
