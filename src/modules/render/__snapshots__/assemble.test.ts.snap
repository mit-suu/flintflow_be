      "heading": "Aggregate AI Costs",
      "id": "function:FN088",
      "level": 3,
      "number": "3.7.25",
      "status": "accepted",
    },
    {
      "awaiting_reaccept": false,
      "blocks": [
        {
          "runs": [
            {
              "bold": true,
              "text": "Trigger: ",
            },
            {
              "text": "Scheduler fires every 5 minutes.",
            },
          ],
          "type": "paragraph",
        },
        {
          "runs": [
            {
              "bold": true,
              "text": "Description: ",
            },
            {
              "text": "Probes the database, the PlantUML server and the LLM provider and records the results.",
            },
          ],
          "type": "paragraph",
        },
        {
          "level": 4,
          "text": "Normal Flow",
          "type": "heading",
        },
        {
          "items": [
            [
              {
                "text": "Scheduler fires the probe.",
              },
            ],
            [
              {
                "text": "System checks each dependency with a timeout.",
              },
            ],
            [
              {
                "text": "System records the health snapshot.",
              },
            ],
          ],
          "type": "numbered_list",
        },
        {
          "level": 4,
          "text": "Abnormal Flow",
          "type": "heading",
        },
        {
          "items": [
            [
              {
                "text": "A probe times out: system records the dependency as degraded and notifies admins in-app.",
              },
            ],
          ],
          "type": "numbered_list",
        },
      ],
      "heading": "Monitor Service Health",
      "id": "function:FN089",
      "level": 3,
      "number": "3.7.26",
      "status": "accepted",
    },
    {
      "blocks": [],
      "heading": "Non-Functional Requirements",
      "id": "group:4",
      "level": 1,
      "number": "4",
    },
    {
      "awaiting_reaccept": false,
      "blocks": [
        {
          "items": [
            [
              {
                "text": "The web client communicates with the backend exclusively over HTTPS REST and SSE endpoints.",
              },
            ],
            [
              {
                "text": "Diagram rendering integrates with a self-hosted PlantUML server so customer data never leaves the deployment.",
              },
            ],
          ],
          "type": "bullet_list",
        },
