          "runs": [
            {
              "text": "Enable a solo founder or business analyst to turn a raw product idea into a complete, internally consistent SRS document through a guided AI conversation, without hiring a requirements engineer.",
            },
          ],
          "type": "paragraph",
        },
        {
          "level": 2,
          "text": "Goals",
          "type": "heading",
        },
        {
          "items": [
            [
              {
                "text": "Produce a baseline-quality SRS following the FPT template within one working day",
              },
            ],
            [
              {
                "text": "Keep every generated statement traceable to a structured field in the SRS Spine",
              },
            ],
            [
              {
                "text": "Block no export: a watermarked working draft is always available after assembly",
              },
            ],
            [
              {
                "text": "Keep AI spend predictable through per-step credit reservation and metering",
              },
            ],
          ],
          "type": "bullet_list",
        },
        {
          "level": 2,
          "text": "Release 1.0 Scope",
          "type": "heading",
        },
