exports[`renderers trên fixture 19 màn > mọi hình: mở/đóng đúng, không dấu tiếng Việt, ổn định giữa hai lần gọi (snapshot) > screen_layout@S01 1`] = `
"@startsalt
{+
  <b>Login
  {#
    <b>Function | <b>Description
    Submit Credentials | Authenticates the user with email and password and issues an access token.
    Log In with Google | Authenticates via Google OAuth and links or creates the local account.
    Toggle Password Visibility | Switches the password input between masked and plain text.
    Navigate to Register | Navigates to the registration screen.
    Open Forgot Password | Opens the Forgot Password popup over the login form.
  }
}
@endsalt
"
`;

exports[`renderers trên fixture 19 màn > mọi hình: mở/đóng đúng, không dấu tiếng Việt, ổn định giữa hai lần gọi (snapshot) > screen_layout@S05 1`] = `
"@startsalt
{+
  <b>Project Dashboard
  {#
    <b>Function | <b>Description
    List Projects | Shows the user's projects with name, status, readiness score and last activity.
    Search Projects | Filters the project cards by name substring.
    Filter by Status | Restricts the list to active or archived projects.
    Open Project | Opens the Project Workspace and resumes at the stored pipeline position.
    Archive Project | Archives the project after confirmation; archived projects stay readable.
    Open Create Project | Opens the Create Project popup.
  }
}
@endsalt
"
`;

exports[`renderers trên fixture 19 màn > mọi hình: mở/đóng đúng, không dấu tiếng Việt, ổn định giữa hai lần gọi (snapshot) > screen_layout@S07 1`] = `
"@startsalt
{+
  <b>Project Workspace
  {#
    <b>Function | <b>Description
    Send Chat Message | Sends the user turn to the pipeline orchestrator for the current step.
    Stream AI Response | Streams the model response into the chat pane over SSE with a cancel control.
    Switch Tab | Switches between Chat, Document and History without losing pane state.
    Render Document Pane | Renders the assembled SRS read-only with status badges per section.
    Accept Step at Gate | Accepts the current step's output, commits its transaction and advances the pipeline.
    Request Revision at Gate | Sends the user's revision notes back to the step within the turn ceiling.
  }
}
@endsalt
"
`;

exports[`renderers trên fixture 19 màn > mọi hình: mở/đóng đúng, không dấu tiếng Việt, ổn định giữa hai lần gọi (snapshot) > screen_layout@S09 1`] = `
"@startsalt
{+
  <b>Verification & Change Panel
  {#
    <b>Function | <b>Description
    List Open Flags | Shows open red and yellow flags with rule, target and remediation step.
    Waive Flag | Waives an eligible red flag with a mandatory typed reason.
    Submit Change Request | Turns a natural-language change request into a previewable op batch.
    Preview Impact Diff | Shows a field-level before/after diff and the dependent sections that become stale.
    Apply Change Transaction | Applies the whole op batch atomically and records the change history.
  }
}
@endsalt
"
`;

exports[`renderers trên fixture 19 màn > mọi hình: mở/đóng đúng, không dấu tiếng Việt, ổn định giữa hai lần gọi (snapshot) > screen_layout@S10 1`] = `
"@startsalt
{+
  <b>Export
  {#
    <b>Function | <b>Description
    Configure Export Options | Chooses between working draft and baseline export and shows blockers.
    Export Working Draft | Renders the current document to Word with a DRAFT watermark on every page.
    Export Baseline Document | Renders the clean document from the baseline snapshot, not from the current Spine.
    Show Export Blockers | Explains which precondition fails and links the shortcut to fix it.
    Download Exported File | Streams the generated .docx to the browser with a versioned file name.
  }
}
@endsalt
"
`;

