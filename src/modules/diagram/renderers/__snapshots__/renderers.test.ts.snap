exports[`renderers trên fixture 19 màn > mọi hình: mở/đóng đúng, không dấu tiếng Việt, ổn định giữa hai lần gọi (snapshot) > deployment 1`] = `
"@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam defaultFontColor #000000
skinparam shadowing false
skinparam roundCorner 0
skinparam ArrowColor #000000
skinparam ArrowThickness 1.2
skinparam BackgroundColor #FFFFFF
skinparam NodeBackgroundColor #7ACFF5
skinparam NodeBorderColor #000000
skinparam ComponentBackgroundColor #FFFFFF
skinparam ComponentBorderColor #000000
skinparam ComponentStyle uml2
skinparam ArtifactBackgroundColor #FFFFFF
skinparam ArtifactBorderColor #000000
skinparam dpi 192
skinparam nodesep 60
skinparam ranksep 60
left to right direction
node "User Device" <<device>> as DN01 {
  component "Web Browser" as DN01_C1
}
node "Application Server" <<device>> as DN02 {
  node "Node.js Runtime" <<executionEnvironment>> as DN03 {
    component "API Service" as DN03_C1
    artifact "api-bundle.js" as DN03_A1
  }
}
node "MongoDB Atlas" as DN04
node "LLM Provider" as DN05
DN01 -- DN03 : HTTPS
DN03 -- DN04 : MongoDB wire protocol
DN03 -- DN05 : HTTPS
@enduml
"
`;

