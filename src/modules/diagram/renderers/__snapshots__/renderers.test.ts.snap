skinparam ArrowColor #000000
skinparam ArrowThickness 1.2
skinparam BackgroundColor #FFFFFF
skinparam ActorBackgroundColor #7ACFF5
skinparam ActorBorderColor #000000
skinparam ParticipantBackgroundColor #7ACFF5
skinparam ParticipantBorderColor #000000
skinparam BoundaryBackgroundColor #7ACFF5
skinparam BoundaryBorderColor #000000
skinparam ControlBackgroundColor #7ACFF5
skinparam ControlBorderColor #000000
skinparam EntityBackgroundColor #7ACFF5
skinparam EntityBorderColor #000000
skinparam SequenceLifeLineBorderColor #000000
skinparam SequenceLifeLineBackgroundColor #7ACFF5
skinparam SequenceLifeLineBorderThickness 1
skinparam SequenceGroupBackgroundColor #FFFFFF
skinparam SequenceGroupBorderColor #000000
skinparam SequenceGroupBorderThickness 1.2
skinparam SequenceGroupFontStyle plain
skinparam SequenceGroupHeaderFontStyle bold
skinparam SequenceGroupBodyBackgroundColor transparent
skinparam dpi 192
skinparam ParticipantPadding 30
skinparam maxMessageSize 220
skinparam sequenceMessageAlign direction
skinparam style strictuml
hide footbox
actor ":Founder" as A01
participant ":System" as SSD_SYSTEM
participant ":LLM Provider" as A06
A01 -> SSD_SYSTEM : 1: Send chat message
activate SSD_SYSTEM
SSD_SYSTEM -> A06 : 1.1: Generate draft reply
activate A06
alt model call times out
  SSD_SYSTEM -->> A01 : 1.2: Show retry prompt
else else
  A06 -->> SSD_SYSTEM : 1.3: Return draft changes
  SSD_SYSTEM -->> A01 : 1.4: Show updated draft
end
deactivate A06
deactivate SSD_SYSTEM
@enduml
"
`;

