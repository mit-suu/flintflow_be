"@startdot
digraph screens_flow {
  graph [fontname="DejaVu Sans", fontsize=13, labelloc=t, compound=true, nodesep=0.4, ranksep=0.5];
  node [fontname="DejaVu Sans", fontsize=11, shape=box, color="#000000"];
  edge [arrowsize=0.8];
  label="Screens flow for Founder";
  START [label="Founder", shape=diamond, style=solid];
  S01 [label="Login"];
  S03 [label="Forgot Password", shape=ellipse];
  S04 [label="Onboarding"];
  S05 [label="Project Dashboard"];
  S06 [label="Create Project", shape=ellipse];
  subgraph cluster_S07 {
    label="Project Workspace"; style=solid;
    S07_T1 [label="Chat"];
    S07_T2 [label="Document"];
    S07_T3 [label="History"];
  }
  S08 [label="Diagram Preview"];
  S09 [label="Verification & Change Panel"];
  S10 [label="Export"];
  S11 [label="Plan & Pricing"];
  S12 [label="Billing History"];
  S13 [label="Notification Center"];
  START -> S01;
  START -> S04;
  S01 -> S03;
  S01 -> S05;
  S04 -> S05;
  S05 -> S06;
  S05 -> S07_T1 [lhead=cluster_S07];
  S05 -> S11;
  S05 -> S13;
  S06 -> S07_T1 [lhead=cluster_S07];
  S07_T1 -> S08 [ltail=cluster_S07];
  S07_T1 -> S09 [ltail=cluster_S07];
  S07_T1 -> S10 [ltail=cluster_S07];
  S09 -> S10;
  S11 -> S12;
}
@enddot
"
`;

